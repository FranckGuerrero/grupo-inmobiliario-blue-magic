---
import MainLayout from '@layouts/MainLayout.astro';
import CTA from '@components/CTA.astro';
import { properties } from '@data/properties';
import { siteConfig } from '@data/site';
import { buildWhatsAppUrl, propertyWhatsAppMessage } from '@utils/whatsapp';

export function getStaticPaths() {
  return properties.map((property) => ({
    params: { slug: property.slug },
    props: { property },
  }));
}

const { property } = Astro.props;
const whatsappUrl = buildWhatsAppUrl(propertyWhatsAppMessage(property.code, property.title, property.district));

const propertySchema = {
  '@context': 'https://schema.org',
  '@type': 'House',
  identifier: property.code,
  name: property.title,
  description: property.summary,
  url: Astro.url.toString(),
  image: new URL(property.image, Astro.site ?? Astro.url).toString(),
  numberOfRooms: property.bedrooms,
  floorSize: {
    '@type': 'QuantitativeValue',
    value: Number.parseFloat(property.area),
    unitCode: 'MTK',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: property.district,
    addressRegion: 'Lima',
    addressCountry: 'PE',
  },
  offers: {
    '@type': 'Offer',
    price: property.priceValue,
    priceCurrency: property.priceCurrency,
    availability: property.status === 'Disponible' ? 'https://schema.org/InStock' : 'https://schema.org/LimitedAvailability',
    seller: {
      '@type': 'RealEstateAgent',
      name: siteConfig.legalName,
      telephone: siteConfig.phoneDisplay,
    },
    ...(property.operation === 'Alquiler' && {
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: property.priceValue,
        priceCurrency: property.priceCurrency,
        unitText: 'MONTH',
      },
    }),
  },
};
---
<MainLayout title={property.title} description={property.summary} image={property.image}>
  <script type="application/ld+json" set:html={JSON.stringify(propertySchema)}></script>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="breadcrumb">Inicio / Propiedades / {property.district}</span>
      <span class="badge">{property.code} · {property.operation} · {property.status}</span>
      <h1>{property.title}</h1>
      <p class="lead">{property.summary}</p>
      <div class="inline-actions">
        <a class="btn btn-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a>
        <a class="btn btn-ghost" href="/propiedades">Volver a propiedades</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <div class="detail-main">
        <div class="detail-image">
          <img src={property.image} alt={property.title} width={property.imageWidth} height={property.imageHeight} loading="eager" />
        </div>
        <article class="card form-card property-description">
          <span class="eyebrow">Descripción</span>
          <h2>Sobre esta propiedad</h2>
          <p class="lead">{property.description}</p>
          <ul class="check-list">
            {property.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </article>
      </div>

      <aside class="detail-sidebar">
        <div class="card form-card">
          <h3>Información rápida</h3>
          <div class="info-list property-info-list">
            <div class="info-row"><span>Código</span><span>{property.code}</span></div>
            <div class="info-row"><span>Precio</span><span>{property.price}</span></div>
            <div class="info-row"><span>Operación</span><span>{property.operation}</span></div>
            <div class="info-row"><span>Estado</span><span>{property.status}</span></div>
            <div class="info-row"><span>Tipo</span><span>{property.type}</span></div>
            <div class="info-row"><span>Distrito</span><span>{property.district}</span></div>
            <div class="info-row"><span>Área construida</span><span>{property.area}</span></div>
            {property.landArea && <div class="info-row"><span>Terreno</span><span>{property.landArea}</span></div>}
            <div class="info-row"><span>Dormitorios</span><span>{property.bedrooms}</span></div>
            <div class="info-row"><span>Baños</span><span>{property.bathrooms}</span></div>
            <div class="info-row"><span>Cocheras</span><span>{property.parking}</span></div>
          </div>
          <a class="btn btn-whatsapp full-width" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Solicitar información</a>
        </div>

        <div class="notice">Por seguridad, la dirección exacta se comparte después de validar al interesado y coordinar la visita.</div>
        <div class="academic-note">{siteConfig.academicDisclaimer}</div>
      </aside>
    </div>
  </section>

  <CTA title="¿Te interesa esta propiedad?" description={`Consulta por el código ${property.code} para validar disponibilidad, condiciones y próximos pasos.`} />
</MainLayout>
